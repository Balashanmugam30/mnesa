# MNESA Local Development Environment Variables Template
# Copy this file to .env.dev for local development. Never commit real production secrets!

# ==========================================
# POSTGRESQL (Primary Relational Database)
# ==========================================
POSTGRES_DB=mnesa_dev
POSTGRES_USER=mnesa_dev_user
POSTGRES_PASSWORD=mnesa_secure_dev_pass_2026!
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# ==========================================
# VALKEY (In-Memory Cache & Session Store)
# ==========================================
VALKEY_PORT=6379
VALKEY_PASSWORD=valkey_secure_dev_pass_2026!
VALKEY_HOST=127.0.0.1

# ==========================================
# MINIO (S3-Compatible Local Object Storage)
# ==========================================
MINIO_ROOT_USER=minio_dev_admin
MINIO_ROOT_PASSWORD=minio_secure_dev_pass_2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST=127.0.0.1

# ==========================================
# APACHE KAFKA (Event Streaming - KRaft)
# ==========================================
KAFKA_PORT=9092
KAFKA_HOST=127.0.0.1

# ==========================================
# BACKEND (Spring Boot)
# ==========================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==========================================
# AI SERVICE (Python / FastAPI)
# ==========================================
AI_SERVICE_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==========================================
# WEB PLATFORM (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
PORT=3000
