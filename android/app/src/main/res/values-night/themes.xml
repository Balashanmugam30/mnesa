<resources>
    <!-- Base Application Theme (Dark Mode) -->
    <style name="Theme.Mnesa" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/mnesa_primary</item>
        <item name="colorOnPrimary">@color/mnesa_on_primary</item>
        <item name="colorSecondary">@color/mnesa_urgency_warning</item>
        <item name="android:colorBackground">@color/mnesa_background</item>
        <item name="colorSurface">@color/mnesa_surface</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/mnesa_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mnesa_background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Translucent Overlay Theme for Instant CaptureActivity (Dark Mode) -->
    <style name="Theme.Mnesa.TransparentCapture" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/mnesa_scrim</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
