<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/mnesa_space_2">

    <!-- User Message Container (Aligned Right) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mnesa_space_12"
            app:cardBackgroundColor="@color/mnesa_primary"
            app:cardCornerRadius="@dimen/mnesa_radius_lg"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/txtUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/mnesa_space_3"
                android:textColor="@color/mnesa_on_primary"
                android:textSize="14sp"
                tools:text="What deadlines do I have this week?" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Assistant Message Container (Aligned Left) -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/mnesa_space_8"
            app:cardBackgroundColor="@color/mnesa_surface_card"
            app:cardCornerRadius="@dimen/mnesa_radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/mnesa_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/mnesa_space_3">

                <!-- Assistant Header Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:text="MNESA AI ASSISTANT"
                        android:textColor="@color/mnesa_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAssistantMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mnesa_text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="You have 2 upcoming deadlines this week:\n1. Google Summer Fellowship (Nov 15)\n2. HackMIT Application (Nov 18)" />

                <!-- Cited Opportunities Container -->
                <LinearLayout
                    android:id="@+id/layoutCitations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mnesa_space_2"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Referenced Opportunities:"
                        android:textColor="@color/mnesa_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCitations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Action Suggestions Container -->
                <LinearLayout
                    android:id="@+id/layoutActionSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mnesa_space_2"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suggested Next Actions:"
                        android:textColor="@color/mnesa_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
