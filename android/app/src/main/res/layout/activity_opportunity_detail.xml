<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mnesa_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mnesa_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Opportunity Details"
            app:titleTextColor="@color/mnesa_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/mnesa_space_4"
            android:paddingVertical="@dimen/mnesa_space_4"
            android:paddingBottom="100dp">

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/badgeCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:textColor="@color/mnesa_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="INTERNSHIP" />

                <TextView
                    android:id="@+id/badgeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mnesa_space_2"
                    android:background="@drawable/bg_badge_pill"
                    android:textColor="@color/mnesa_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="SAVED" />

                <TextView
                    android:id="@+id/badgePriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mnesa_space_2"
                    android:background="@drawable/bg_badge_pill"
                    android:textColor="@color/mnesa_urgency_warning"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="HIGH" />

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_3"
                android:textColor="@color/mnesa_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Summer Engineering Fellowship 2026" />

            <!-- Organization -->
            <TextView
                android:id="@+id/txtOrganization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_1"
                android:textColor="@color/mnesa_text_secondary"
                android:textSize="16sp"
                tools:text="Google Research" />

            <!-- Deadline Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeadline"
                style="@style/Widget.Mnesa.Card.Opportunity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/mnesa_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_deadline_clock"
                            app:tint="@color/mnesa_urgency_warning" />

                        <TextView
                            android:id="@+id/txtDeadlineCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mnesa_space_2"
                            android:textColor="@color/mnesa_urgency_warning"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="3 days remaining" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDeadlineDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_1"
                        android:textColor="@color/mnesa_text_secondary"
                        android:textSize="13sp"
                        tools:text="May 15, 2026 at 11:59 PM UTC" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Key Details Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mnesa.Card.Opportunity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/mnesa_space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:textColor="@color/mnesa_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_2"
                        android:textColor="@color/mnesa_text_secondary"
                        android:textSize="14sp"
                        tools:text="Location: Mountain View, CA (Hybrid)" />

                    <TextView
                        android:id="@+id/txtEligibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_1"
                        android:textColor="@color/mnesa_text_secondary"
                        android:textSize="14sp"
                        tools:text="Eligibility: Undergraduate / Masters students" />

                    <TextView
                        android:id="@+id/txtEstimatedEffort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_1"
                        android:textColor="@color/mnesa_text_secondary"
                        android:textSize="14sp"
                        tools:text="Effort: 2-3 hours" />

                    <TextView
                        android:id="@+id/txtConfidenceScore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_1"
                        android:textColor="@color/mnesa_status_success"
                        android:textSize="13sp"
                        tools:text="AI Extraction Confidence: 94%" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Links Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLinks"
                style="@style/Widget.Mnesa.Card.Opportunity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/mnesa_space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Source &amp; Application"
                        android:textColor="@color/mnesa_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenRegistration"
                        style="@style/Widget.Mnesa.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_2"
                        android:text="Open Registration Page"
                        app:icon="@drawable/ic_open_in_new" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSource"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mnesa_space_1"
                        android:text="View Original Source"
                        app:icon="@drawable/ic_open_in_new" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Description Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_4"
                android:text="Description"
                android:textColor="@color/mnesa_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/mnesa_text_secondary"
                android:textSize="14sp"
                tools:text="Full description of the opportunity goes here..." />

            <!-- Reminders Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_4"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/lblReminders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scheduled Reminders"
                    android:textColor="@color/mnesa_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddReminder"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add"
                    android:textColor="@color/mnesa_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRemindersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_1"
                android:orientation="vertical" />

            <!-- Activity History Section -->
            <TextView
                android:id="@+id/lblHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_4"
                android:text="Activity Timeline"
                android:textColor="@color/mnesa_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_2"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/mnesa_surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/mnesa_space_4"
        android:paddingVertical="@dimen/mnesa_space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeStatus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update Status" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditOpportunity"
            style="@style/Widget.Mnesa.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mnesa_space_2"
            android:layout_weight="1"
            android:text="Edit"
            app:icon="@drawable/ic_edit" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
