<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_progress"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSuggestionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mnesa_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Prepare application materials" />

        <TextView
            android:id="@+id/txtSuggestionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mnesa_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Oct 12, 2026 at 9:00 AM" />

        <TextView
            android:id="@+id/txtSuggestionReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mnesa_text_secondary"
            android:textSize="11sp"
            tools:text="Recommended 7 days early based on scholarship requirements." />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplySuggestion"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:text="@string/btn_apply_suggestion"
        android:textSize="11sp" />

</LinearLayout>
