<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/captureRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mnesa_scrim">

    <!-- Bottom Sheet Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCaptureSheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/mnesa_surface_card"
        app:cardCornerRadius="@dimen/mnesa_radius_xl"
        app:cardElevation="@dimen/mnesa_elevation_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/mnesa_space_6">

            <!-- Drag Handle / Indicator -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/mnesa_space_4"
                android:background="@color/mnesa_border_strong" />

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Progress Spinner -->
                <ProgressBar
                    android:id="@+id/progressSpinner"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/mnesa_primary"
                    android:visibility="gone" />

                <!-- Status Icon -->
                <ImageView
                    android:id="@+id/imgCaptureIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_status_check"
                    app:tint="@color/mnesa_status_success" />

                <TextView
                    android:id="@+id/txtCaptureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mnesa_space_3"
                    android:layout_weight="1"
                    android:text="@string/capture_dialog_title"
                    android:textColor="@color/mnesa_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Source Badge -->
                <TextView
                    android:id="@+id/badgeSourceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mnesa_space_2"
                    android:background="@drawable/bg_badge_pill"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/mnesa_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preview Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_4"
                app:cardBackgroundColor="@color/mnesa_surface_card"
                app:cardCornerRadius="@dimen/mnesa_radius_md"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/txtCapturedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:padding="@dimen/mnesa_space_3"
                    android:textColor="@color/mnesa_text_secondary"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <!-- AI Extraction Details Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardExtraction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_3"
                android:visibility="gone"
                app:cardBackgroundColor="@color/mnesa_surface"
                app:cardCornerRadius="@dimen/mnesa_radius_md"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/mnesa_space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtExtractedOrg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/mnesa_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/mnesa_status_success"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtExtractedDeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/mnesa_urgency_warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtExtractedSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="@color/mnesa_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtEvidenceSnippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/mnesa_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Capture Status Indicator -->
            <TextView
                android:id="@+id/txtCaptureStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_3"
                android:text="@string/capture_success"
                android:textColor="@color/mnesa_status_success"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mnesa_space_6"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Mnesa.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/mnesa_space_3"
                    android:layout_weight="1"
                    android:text="@string/capture_action_retry"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnConfirmOpportunity"
                    style="@style/Widget.Mnesa.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/mnesa_space_3"
                    android:layout_weight="1"
                    android:text="@string/capture_confirm"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDone"
                    style="@style/Widget.Mnesa.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/capture_done" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
