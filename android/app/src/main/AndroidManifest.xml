<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network and system permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MnesaApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_mnesa_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_mnesa_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mnesa">

        <!-- Launch / Splash Activity -->
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Welcome Onboarding Activity -->
        <activity
            android:name=".presentation.welcome.WelcomeActivity"
            android:exported="false" />

        <!-- Authentication Activities -->
        <activity
            android:name=".presentation.auth.SignInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Onboarding Personalization -->
        <activity
            android:name=".presentation.onboarding.OnboardingInterestsActivity"
            android:exported="false" />

        <!-- Settings & Profile -->
        <activity
            android:name=".presentation.settings.SettingsActivity"
            android:exported="false" />

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="false" />

        <!-- Opportunity Management Activities -->
        <activity
            android:name=".presentation.opportunities.OpportunityDetailActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mnesa" android:host="opportunity" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.opportunities.EditOpportunityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.opportunities.AddOpportunityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reminder Editor Activity -->
        <activity
            android:name=".presentation.reminders.ReminderEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification History Activity -->
        <activity
            android:name=".presentation.notifications.NotificationsActivity"
            android:exported="false" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".core.notification.MnesaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Ultra-Fast Share Target Capture Activity -->
        <activity
            android:name=".presentation.capture.CaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.Mnesa.TransparentCapture">

            <!-- Single Share Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Multiple Share Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
